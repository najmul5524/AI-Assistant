# Telegram Bot Token (Get from https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security: Allowed Telegram User IDs (comma-separated). Get your ID from https://t.me/userinfobot
# If left empty, anyone can access your bot. Setting this keeps your free quota safe!
ALLOWED_USER_IDS=

# Multi-Tier AI Provider Keys (All have Free Tiers)
# Tier 1: Google Gemini (Get free at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Tier 2: Groq Cloud (Ultra-fast, Llama 3.3 70B - Get free at: https://console.groq.com/)
GROQ_API_KEY=

# Tier 3: OpenRouter (Optional free fallback - Get free at: https://openrouter.ai/)
OPENROUTER_API_KEY=

# Bot Customization
BOT_NAME=Nova AI
DEFAULT_TIMEZONE=Asia/Dhaka

# Forex Factory & Google Calendar Settings
FOREX_MIN_IMPACT=Medium
FOREX_CURRENCIES=USD,EUR,GBP,JPY,AUD,CAD,CHF,NZD
FOREX_REMINDER_MINUTES=15
FOREX_DAILY_SYNC_TIME=06:30
FOREX_NEWS_CHECK_INTERVAL=120
